[Unit]
Description=Polymarket-Kalshi Arbitrage Bot Frontend Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/polymarket-kalshi-btc-arbitrage-bot/frontend
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PORT=3000"

[Install]
WantedBy=multi-user.target
