[Unit]
Description=Polymarket-Kalshi Arbitrage Bot Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/polymarket-kalshi-btc-arbitrage-bot/backend
ExecStart=/usr/bin/python3 /home/ubuntu/polymarket-kalshi-btc-arbitrage-bot/backend/api.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
