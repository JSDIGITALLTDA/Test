# ============================================================================
# Enhanced Arbitrage Bot Configuration
# ============================================================================
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit the actual .env file to git
# 2. NEVER share your private keys with anyone
# 3. Copy this file to `.env` and fill in your credentials
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API keys and private keys
# 3. Keep .env in .gitignore (already configured)
# ============================================================================

# ----------------------------------------------------------------------------
# BOT CONFIGURATION
# ----------------------------------------------------------------------------

# Trading Mode: "dry-run" or "live"
# ALWAYS start with dry-run to test the system!
TRADING_MODE=dry-run

# Minimum profit required to execute a trade (in dollars)
# Example: 0.02 = $0.02 = 2 cents per contract
MIN_PROFIT=0.02

# Minimum number of contracts required for liquidity
MIN_CONTRACTS=50

# Maximum acceptable slippage (in dollars)
# Example: 0.005 = half a cent
MAX_SLIPPAGE=0.005

# Scan interval in seconds
SCAN_INTERVAL=2

# ----------------------------------------------------------------------------
# KALSHI API CREDENTIALS
# ----------------------------------------------------------------------------
# Get these from: https://kalshi.com/settings/api-keys
#
# Steps to get Kalshi credentials:
# 1. Log in to Kalshi
# 2. Go to Settings -> API Keys
# 3. Click "Create Key"
# 4. Download the .pem file
# 5. Copy the API Key ID here
# 6. Put the .pem file path below

KALSHI_API_KEY=your_kalshi_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=/path/to/your/kalshi_private_key.pem

# Kalshi fee rate (as decimal)
# Default is 7% = 0.07
# Check current fees at: https://kalshi.com/fees
KALSHI_FEE_RATE=0.07

# ----------------------------------------------------------------------------
# POLYMARKET API CREDENTIALS
# ----------------------------------------------------------------------------
# Get these from your Ethereum wallet (MetaMask, etc.)
#
# Steps to get Polymarket credentials:
# 1. Export your Ethereum private key from MetaMask
# 2. Paste it here (WITHOUT the 0x prefix)
#
# SECURITY WARNING:
# - This private key controls your Polymarket wallet
# - Anyone with this key can spend your funds
# - Use a dedicated wallet for trading, not your main wallet
# - Start with a small amount until you're confident

POLYMARKET_PRIVATE_KEY=your_ethereum_private_key_here

# Polymarket fee rate (gasless with Safe Wallet = 0)
POLYMARKET_FEE_RATE=0.0

# ----------------------------------------------------------------------------
# ADVANCED SETTINGS (Optional)
# ----------------------------------------------------------------------------

# Maximum time allowed between leg executions (seconds)
# If the second leg doesn't fill in this time, cancel the first
MAX_EXECUTION_TIME=5.0

# Default trade size (number of contracts)
# START SMALL! Test with 10-50 contracts first
DEFAULT_TRADE_SIZE=10

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# MARKET CATEGORIES
# ----------------------------------------------------------------------------
# Comma-separated list of market categories to trade
# Options: crypto_price, sports, politics, macro, weather
# For now, only crypto_price is fully implemented
ENABLED_MARKETS=crypto_price

# ----------------------------------------------------------------------------
# NOTIFICATION SETTINGS (Future Feature)
# ----------------------------------------------------------------------------

# Email notifications
EMAIL_ENABLED=false
EMAIL_ADDRESS=your_email@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password

# Slack notifications
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord notifications
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ----------------------------------------------------------------------------
# DATABASE (Future Feature)
# ----------------------------------------------------------------------------

# SQLite database for storing trade history
DATABASE_PATH=./data/arbitrage_trades.db

# ----------------------------------------------------------------------------
# RISK MANAGEMENT
# ----------------------------------------------------------------------------

# Maximum total exposure (in dollars)
# The bot will stop trading if total position exceeds this
MAX_TOTAL_EXPOSURE=1000.00

# Maximum number of simultaneous open positions
MAX_OPEN_POSITIONS=5

# Stop trading after this many consecutive failures
MAX_CONSECUTIVE_FAILURES=3

# Cooldown period after failure (seconds)
FAILURE_COOLDOWN=60
